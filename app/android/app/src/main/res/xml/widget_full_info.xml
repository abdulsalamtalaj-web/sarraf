<?xml version="1.0" encoding="utf-8"?>
<!-- 4×3 لوحة السوق الكاملة: جدول شراء/مبيع لكل العملات + الذهب بكل عياراته بالدولار -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="220dp"
    android:minResizeHeight="160dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_full"
    android:previewLayout="@layout/widget_full"
    android:description="@string/widget_full_desc"
    android:widgetCategory="home_screen" />
