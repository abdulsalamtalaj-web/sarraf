{
  "name": "lira-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-lib": "node scripts/sync-lib.mjs",
    "ota": "node scripts/make-ota.mjs",
    "icons": "node scripts/make-icons.mjs",
    "serve": "npx --yes http-server www -p 5173 -c-1",
    "build:apk": "npm run sync-lib && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:release": "npm run sync-lib && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/background-runner": "^2.2.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "simple-icons": "^16.37.0"
  }
}
